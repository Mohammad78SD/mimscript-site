// Cloudflare Workers static assets: serves the `next build` export in ./out.
// (Cloudflare Pages ignores this file and uses its own build settings.)
{
  "name": "mimscript",
  "compatibility_date": "2026-10-01",
  // only serve on the custom domains below, no extra *.workers.dev copy
  "workers_dev": false,
  "preview_urls": false,
  // both listed so a deploy never detaches either one;
  // keep mimscript.com until the new business site replaces it
  "routes": [
    { "pattern": "cv.mimscript.com", "custom_domain": true },
    { "pattern": "mimscript.com", "custom_domain": true }
  ],
  // small Worker in front of the assets: Iran / Persian-browser redirect on "/" only
  "main": "./worker.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // run worker.js only for the homepage; every other path is served directly from ./out
    "run_worker_first": ["/"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
